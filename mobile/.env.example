# Mobile client configuration.
#
# Copy to .env — the root .gitignore excludes `.env`, so real values stay local.
# Only EXPO_PUBLIC_* variables are inlined into the client bundle by Expo, so
# nothing secret may be added here: this file ships to the device.

# Serve every API call from local fixtures (src/api/mock.ts) instead of HTTP.
#
# Off by default: login (SS-US-01), invite (UM-US-01), and activate (UM-US-02)
# are all real, verified backend routes now. Set to 1 to fall back to
# fixtures — e.g. to explore UM-US-03 (list users) or Features 03-11, which
# have no backend yet and only ever existed as fixture-driven screens.
EXPO_PUBLIC_API_MOCK=0

# Base URL of the FastAPI backend (SDS §6.1: /api/v1).
# Both Metro and uvicorn run inside WSL, so localhost resolves without extra
# configuration. Start the API with:
#   cd backend && uv run uvicorn app.main:app --reload --port 8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Shows the Family > Invites "copy activation link" action, which reads
# GET /api/v1/dev/outbox (ADMIN, non-production only) — see backend
# EMAIL_TRANSPORT=outbox. This is dev chrome, not a feature. Off by default.
EXPO_PUBLIC_DEV_TOOLS=0
