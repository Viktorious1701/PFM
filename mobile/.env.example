# Mobile client configuration.
#
# Copy to .env — the root .gitignore excludes `.env`, so real values stay local.
# Only EXPO_PUBLIC_* variables are inlined into the client bundle by Expo, so
# nothing secret may be added here: this file ships to the device.

# Base URL of the FastAPI backend (SDS §6.1: /api/v1).
# Both Metro and uvicorn run inside WSL, so localhost resolves without extra
# configuration. Start the API with:
#   cd backend && uv run uvicorn app.main:app --reload --port 8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
