# Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# SQLite for local dev (Docker is unavailable in this WSL2 setup).
# Postgres later is a one-line change:
#   DATABASE_URL=postgresql+psycopg://pfm:pfm@localhost:5432/pfm
DATABASE_URL=sqlite:///./pfm.db

# --- Auth -----------------------------------------------------------------
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=60

# --- Invitations (US-01-01 / US-01-02) ------------------------------------
INVITATION_TTL_HOURS=24
# {token} is substituted with the raw invitation token.
#
# This is the MOBILE APP's activate screen, not a backend route — port 8000 is
# uvicorn (nothing there resolves /activate). Metro's web dev server is 8081
# (mobile/app/activate.tsx); native uses the app scheme instead:
#   pfm://activate?token={token}  (see mobile/app.json "scheme")
# Production: https://your-domain.example/activate?token={token}
ACTIVATION_URL_TEMPLATE=http://localhost:8081/activate?token={token}

# --- Gmail SMTP -----------------------------------------------------------
# Requires 2FA on the account + a 16-char App Password (NOT your login password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=PFM <your.address@gmail.com>

# "background" = respond 201 immediately, send after (meets NFR-3 <500ms).
# "sync"       = send before responding, surface 502 on failure.
#                Use this while first wiring up Gmail so mistakes are visible.
EMAIL_SEND_MODE=background

# --- Email transport (UM-US-01 A13) ---------------------------------------
# "auto"   = real SMTP when SMTP_USER/SMTP_PASSWORD are set, otherwise a
#            no-op recording double (default; unchanged from before).
# "smtp"   = force real SMTP even without credentials, so a misconfiguration
#            surfaces immediately instead of silently degrading.
# "outbox" = write each message to OUTBOX_DIR as a .eml file instead of
#            sending it — read activation links via GET /api/v1/dev/outbox
#            (ADMIN, non-production only) without needing a real mailbox.
EMAIL_TRANSPORT=auto
OUTBOX_DIR=var/outbox

# --- CORS -------------------------------------------------------------
# Origins allowed to call the API from a browser. Only needed because the
# Expo web client (localhost:8081) is a different origin than the API
# (localhost:8000) during local dev. Comma-separated.
CORS_ALLOW_ORIGINS=["http://localhost:8081"]

# --- Android App Links (reserved; fill after the first signed build) ------
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
